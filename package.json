{
  "name": "picturemore",
  "version": "1.0.1",
  "description": "本地图片压缩工具，图片内容永不离开你的电脑",
  "main": "./out/main/index.js",
  "author": "pictureMore",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build && electron-builder",
    "build:dir": "electron-vite build && electron-builder --dir",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "fixtures": "node scripts/make-fixtures.mjs",
    "lint:no-resize": "node scripts/check-no-resize.mjs",
    "verify:icc": "node scripts/verify-icc-attach.mjs",
    "smoke": "electron-vite build && node scripts/smoke-context-isolation.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "measure:500": "electron-vite build && node scripts/measure-500.mjs",
    "check": "npm run lint:no-resize && npm run typecheck && npm run test"
  },
  "dependencies": {
    "heic-decode": "^2.1.0",
    "sharp": "^0.35.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
